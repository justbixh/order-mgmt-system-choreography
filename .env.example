# Every value below is optional: compose falls back to these local-dev defaults.

# Where the containerised services find their dependencies (inside the compose network)
DB_HOST=postgres
DB_PORT=5432
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
# Jaeger only ingests traces; keep false unless you add a metrics backend
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false

# ports
POSTGRES_PORT=5432
KAFKA_UI_PORT=8090
JAEGER_UI_PORT=16686
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
